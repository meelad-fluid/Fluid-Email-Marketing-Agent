# Supabase (project: FLUID | Email Marketing Agent). Without these, local development uses out/dev-store.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public address of the app, used in onboarding links (e.g. https://agent.fluidcreatives.com)
NEXT_PUBLIC_APP_URL=

# Fluid's Shopify app (Shopify Dev Dashboard). Enables "Install Fluid on Shopify" in onboarding.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Claude API key: runs the brain's agents (strategist now; copywriter, designer and reporter next)
ANTHROPIC_API_KEY=

# Protects the scheduled jobs (nightly Klaviyo sync, monthly planning). Any long random string.
CRON_SECRET=
