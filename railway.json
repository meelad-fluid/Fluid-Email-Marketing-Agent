{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": ["bot/**", "lib/**", "scripts/**", "brain/**", "knowledge/**", "package.json", "package-lock.json", "Dockerfile", "railway.json"]
  },
  "deploy": { "numReplicas": 1, "restartPolicyType": "ALWAYS", "sleepApplication": false }
}
