{
  "key": "site-abandonment",
  "name": "Site Abandonment",
  "version": 1,
  "status": "draft",
  "purpose": "Bring back people who landed on the site but didn't view a product, add to cart or start checkout, and get them exploring the catalog.",
  "source": {
    "kind": "klaviyo-import",
    "note": "Core flow. Built from the Fluid flow in the reference Klaviyo account (2026-10-20), with Fluid-approved fixes noted in notes."
  },
  "trigger": {
    "type": "metric",
    "source": "Active on Site",
    "filters": []
  },
  "profileFilter": [
    {
      "description": "Viewed Product zero times since starting this flow",
      "klaviyo": {
        "type": "profile-metric",
        "metric_id": "{{metric:Viewed Product}}",
        "measurement": "count",
        "measurement_filter": {
          "type": "numeric",
          "operator": "equals",
          "value": 0
        },
        "timeframe_filter": {
          "type": "date",
          "operator": "flow-start"
        },
        "metric_filters": null
      }
    },
    {
      "description": "Added to Cart zero times since starting this flow",
      "klaviyo": {
        "type": "profile-metric",
        "metric_id": "{{metric:Added to Cart}}",
        "measurement": "count",
        "measurement_filter": {
          "type": "numeric",
          "operator": "equals",
          "value": 0
        },
        "timeframe_filter": {
          "type": "date",
          "operator": "flow-start"
        },
        "metric_filters": null
      }
    },
    {
      "description": "Checkout Started zero times since starting this flow",
      "klaviyo": {
        "type": "profile-metric",
        "metric_id": "{{metric:Checkout Started}}",
        "measurement": "count",
        "measurement_filter": {
          "type": "numeric",
          "operator": "equals",
          "value": 0
        },
        "timeframe_filter": {
          "type": "date",
          "operator": "flow-start"
        },
        "metric_filters": null
      }
    },
    {
      "description": "Placed Order zero times since starting this flow",
      "klaviyo": {
        "type": "profile-metric",
        "metric_id": "{{metric:Placed Order}}",
        "measurement": "count",
        "measurement_filter": {
          "type": "numeric",
          "operator": "equals",
          "value": 0
        },
        "timeframe_filter": {
          "type": "date",
          "operator": "flow-start"
        },
        "metric_filters": null
      }
    }
  ],
  "reentry": {
    "value": 30,
    "unit": "days"
  },
  "entry": "delay-4",
  "actions": [
    {
      "id": "delay-4",
      "type": "time-delay",
      "delay": {
        "value": 2,
        "unit": "hours"
      },
      "next": "site-1"
    },
    {
      "id": "site-1",
      "type": "send-email",
      "job": "Were you just checking us out? Invite them back to explore",
      "template": "site-abandonment/01-find-your-way",
      "subject": [
        "We saved your picks…ready when you are"
      ],
      "smartSending": false,
      "next": "delay-3"
    },
    {
      "id": "delay-3",
      "type": "time-delay",
      "delay": {
        "value": 3,
        "unit": "hours"
      },
      "next": "split-4"
    },
    {
      "id": "split-4",
      "type": "conditional-split",
      "condition": {
        "description": "Placed Order zero times since starting this flow",
        "klaviyo": {
          "type": "profile-metric",
          "metric_id": "{{metric:Placed Order}}",
          "measurement": "count",
          "measurement_filter": {
            "type": "numeric",
            "operator": "equals",
            "value": 0
          },
          "timeframe_filter": {
            "type": "date",
            "operator": "flow-start"
          },
          "metric_filters": null
        }
      },
      "next_if_true": "split-1",
      "next_if_false": null
    },
    {
      "id": "split-1",
      "type": "conditional-split",
      "condition": {
        "description": "Opened Email at least once since starting this flow",
        "klaviyo": {
          "type": "profile-metric",
          "metric_id": "{{metric:Opened Email}}",
          "measurement": "count",
          "measurement_filter": {
            "type": "numeric",
            "operator": "greater-than",
            "value": 0
          },
          "timeframe_filter": {
            "type": "date",
            "operator": "flow-start"
          },
          "metric_filters": null
        }
      },
      "next_if_true": "delay-1",
      "next_if_false": "site-1-resend"
    },
    {
      "id": "site-1-resend",
      "type": "send-email",
      "job": "Resend of \"Were you just checking us out? Invite them back to explore\" to people who didn't open it",
      "template": "site-abandonment/01-find-your-way",
      "subject": [
        "We saved your picks…ready when you are"
      ],
      "smartSending": false,
      "resendOf": "site-1",
      "next": "delay-2"
    },
    {
      "id": "delay-2",
      "type": "time-delay",
      "delay": {
        "value": 21,
        "unit": "hours"
      },
      "next": "split-3"
    },
    {
      "id": "split-3",
      "type": "conditional-split",
      "condition": {
        "description": "Placed Order zero times since starting this flow",
        "klaviyo": {
          "type": "profile-metric",
          "metric_id": "{{metric:Placed Order}}",
          "measurement": "count",
          "measurement_filter": {
            "type": "numeric",
            "operator": "equals",
            "value": 0
          },
          "timeframe_filter": {
            "type": "date",
            "operator": "flow-start"
          },
          "metric_filters": null
        }
      },
      "next_if_true": "site-2-b",
      "next_if_false": null
    },
    {
      "id": "site-2-b",
      "type": "send-email",
      "job": "Take a look at these best sellers (resend track)",
      "template": "site-abandonment/02-best-sellers",
      "subject": [
        "{{copy.site_bestseller_subject}}"
      ],
      "smartSending": false,
      "next": null
    },
    {
      "id": "delay-1",
      "type": "time-delay",
      "delay": {
        "value": 21,
        "unit": "hours"
      },
      "next": "split-2"
    },
    {
      "id": "split-2",
      "type": "conditional-split",
      "condition": {
        "description": "Placed Order zero times since starting this flow",
        "klaviyo": {
          "type": "profile-metric",
          "metric_id": "{{metric:Placed Order}}",
          "measurement": "count",
          "measurement_filter": {
            "type": "numeric",
            "operator": "equals",
            "value": 0
          },
          "timeframe_filter": {
            "type": "date",
            "operator": "flow-start"
          },
          "metric_filters": null
        }
      },
      "next_if_true": "site-2",
      "next_if_false": null
    },
    {
      "id": "site-2",
      "type": "send-email",
      "job": "Take a look at these best sellers",
      "template": "site-abandonment/02-best-sellers",
      "subject": [
        "{{copy.site_bestseller_subject}}"
      ],
      "smartSending": false,
      "next": null
    }
  ],
  "variables": [
    {
      "key": "copy.site_bestseller_subject",
      "description": "Best sellers subject",
      "example": "Superfoods harvested by hand, priced for real life"
    }
  ],
  "benchmarks": {
    "reference revenue per recipient": "$2.10",
    "reference order rate": "0.54%"
  },
  "notes": "Email 1 sends 2 hours after the visit. Fix vs reference account: added the filter excluding product views, add to cart and checkout."
}
