{
  "key": "winback",
  "name": "Winback",
  "version": 1,
  "status": "draft",
  "purpose": "Re-engage lapsed customers and get a repeat purchase, timed to the brand's usual time between orders.",
  "source": {
    "kind": "klaviyo-import",
    "note": "Core flow. Built from the Fluid flow in the reference Klaviyo account (2026-10-20), with Fluid-approved fixes noted in notes."
  },
  "trigger": {
    "type": "metric",
    "source": "Placed Order",
    "filters": []
  },
  "profileFilter": [
    {
      "description": "Placed Order zero times since starting this flow",
      "klaviyo": {
        "type": "profile-metric",
        "metric_id": "{{metric:Placed Order}}",
        "measurement": "count",
        "measurement_filter": {
          "type": "numeric",
          "operator": "equals",
          "value": 0
        },
        "timeframe_filter": {
          "type": "date",
          "operator": "flow-start"
        },
        "metric_filters": null
      }
    }
  ],
  "reentry": {
    "value": 1,
    "unit": "days"
  },
  "entry": "delay-4",
  "actions": [
    {
      "id": "delay-4",
      "type": "time-delay",
      "delay": {
        "value": 90,
        "unit": "days"
      },
      "next": "winback-1"
    },
    {
      "id": "winback-1",
      "type": "send-email",
      "job": "We miss you: remind them of the ritual/benefit",
      "template": "winback/01a-check-in-plain",
      "subject": [
        "Your {{copy.winback_ritual}} awaits its next chapter"
      ],
      "smartSending": false,
      "next": "delay-3"
    },
    {
      "id": "delay-3",
      "type": "time-delay",
      "delay": {
        "value": 5,
        "unit": "days"
      },
      "next": "winback-2"
    },
    {
      "id": "winback-2",
      "type": "send-email",
      "job": "Reignite: re-sell the core benefits",
      "template": "winback/01b-check-in-designed",
      "subject": [
        "Reignite your ritual"
      ],
      "smartSending": false,
      "next": "delay-2"
    },
    {
      "id": "delay-2",
      "type": "time-delay",
      "delay": {
        "value": 7,
        "unit": "days"
      },
      "next": "winback-3"
    },
    {
      "id": "winback-3",
      "type": "send-email",
      "job": "Come-back offer: {{discount.winback_value}} off, 3 days left",
      "template": "winback/02-come-back-offer",
      "subject": [
        "3 days left to restock your favorites"
      ],
      "smartSending": false,
      "next": "delay-1"
    },
    {
      "id": "delay-1",
      "type": "time-delay",
      "delay": {
        "value": 2,
        "unit": "days"
      },
      "next": "winback-4"
    },
    {
      "id": "winback-4",
      "type": "send-email",
      "job": "Come-back offer ending in 48 hours",
      "template": "winback/02-come-back-offer",
      "subject": [
        "{{discount.winback_value}} off ends in 48 hours"
      ],
      "smartSending": false,
      "next": null
    }
  ],
  "variables": [
    {
      "key": "winback.days_after_order",
      "description": "Days after the last order before winback starts (the brand's typical time between orders)",
      "example": "90"
    },
    {
      "key": "discount.winback_code",
      "description": "Come-back offer code",
      "example": "COMEBACK15"
    },
    {
      "key": "discount.winback_value",
      "description": "Come-back offer",
      "example": "15%"
    },
    {
      "key": "copy.winback_ritual",
      "description": "What the customer's routine with the product is called",
      "example": "superfood ritual"
    }
  ],
  "benchmarks": {},
  "notes": "The first wait is {{winback.days_after_order}} days (set per client, default 90). No 'not in this flow' filter: it would block the newer order's entry."
}
