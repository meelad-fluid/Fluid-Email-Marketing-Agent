{
  "key": "welcome",
  "name": "Welcome Flow",
  "version": 1,
  "status": "draft",
  "purpose": "Convert new subscribers with a welcome offer, build trust (founder, reviews, best sellers), and close with an upgraded 24-hour offer. Email 1 is angled to the answer they picked in the pop-up.",
  "source": {
    "kind": "klaviyo-import",
    "note": "Core flow. Built from the Fluid flow in the reference Klaviyo account (2026-10-20), with Fluid-approved fixes noted in notes."
  },
  "trigger": {
    "type": "list",
    "source": "{{lists.newsletter}}",
    "filters": []
  },
  "profileFilter": [
    {
      "description": "Placed Order zero times since starting this flow",
      "klaviyo": {
        "type": "profile-metric",
        "metric_id": "{{metric:Placed Order}}",
        "measurement": "count",
        "measurement_filter": {
          "type": "numeric",
          "operator": "equals",
          "value": 0
        },
        "timeframe_filter": {
          "type": "date",
          "operator": "flow-start"
        },
        "metric_filters": null
      }
    }
  ],
  "reentry": null,
  "entry": "split-1",
  "actions": [
    {
      "id": "split-1",
      "type": "conditional-split",
      "condition": {
        "description": "Pop-up answer ({{popup.property}}) = {{popup.option_1}}",
        "klaviyo": {
          "type": "profile-property",
          "property": "properties['{{popup.property}}']",
          "filter": {
            "type": "string",
            "operator": "equals",
            "value": "{{popup.option_1}}"
          }
        }
      },
      "next_if_true": "welcome-1-o1",
      "next_if_false": "split-16"
    },
    {
      "id": "split-16",
      "type": "conditional-split",
      "condition": {
        "description": "Pop-up answer ({{popup.property}}) = {{popup.option_2}}",
        "klaviyo": {
          "type": "profile-property",
          "property": "properties['{{popup.property}}']",
          "filter": {
            "type": "string",
            "operator": "equals",
            "value": "{{popup.option_2}}"
          }
        }
      },
      "next_if_true": "welcome-1-o2",
      "next_if_false": "welcome-1-o3"
    },
    {
      "id": "welcome-1-o3",
      "type": "send-email",
      "job": "Welcome offer, angled to pop-up answer #3: welcome to the brand, give the {{discount.welcome_value}} code, brand mission, the benefit they picked, best sellers",
      "template": "welcome/01-welcome-offer",
      "subject": [
        "{{copy.welcome_subject_3}}"
      ],
      "smartSending": false,
      "next": "split-44"
    },
    {
      "id": "split-44",
      "type": "conditional-split",
      "condition": {
        "description": "Can receive SMS marketing",
        "klaviyo": {
          "type": "profile-marketing-consent",
          "consent": {
            "channel": "sms",
            "can_receive_marketing": true,
            "consent_status": {
              "subscription": "subscribed",
              "filters": null
            }
          }
        }
      },
      "next_if_true": "welcome-sms-1-o3",
      "next_if_false": "delay-27"
    },
    {
      "id": "welcome-sms-1-o3",
      "type": "send-sms",
      "job": "Welcome them to the brand and give them the welcome offer",
      "body": "Welcome to {{brand.name}}! Here's {{discount.welcome_value}} off your first order: {{discount.welcome_code}}",
      "next": "delay-27"
    },
    {
      "id": "delay-27",
      "type": "time-delay",
      "delay": {
        "value": 3,
        "unit": "hours"
      },
      "next": "split-43"
