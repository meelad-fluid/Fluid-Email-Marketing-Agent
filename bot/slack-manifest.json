{
  "display_information": {
    "name": "Fluid",
    "description": "Fluid Creatives' email agent: strategy, copy and design for the client in each channel.",
    "background_color": "#1d1d1d"
  },
  "features": {
    "bot_user": {
      "display_name": "Fluid",
      "always_online": true
    },
    "slash_commands": [
      {
        "command": "/fluid",
        "description": "Link this channel to a client, or check which client it belongs to",
        "usage_hint": "onboard <Client> | status | shopify | klaviyo-drafts on|off | shopify-discounts on|off | help",
        "should_escape": false
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read",
        "channels:history",
        "groups:history",
        "channels:read",
        "groups:read",
        "chat:write",
        "commands",
        "files:read",
        "files:write",
        "reactions:write",
        "users:read",
        "groups:write",
        "groups:write.invites",
        "channels:manage",
        "channels:write.invites"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": [
        "app_mention",
        "message.channels",
        "message.groups"
      ]
    },
    "interactivity": {
      "is_enabled": false
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
